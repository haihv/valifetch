{
  "name": "valifetch",
  "version": "0.6.0",
  "description": "Type-safe HTTP client built on native fetch with valibot schema validation",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./error": {
      "import": {
        "types": "./dist/error.d.ts",
        "default": "./dist/error.js"
      },
      "require": {
        "types": "./dist/error.d.cts",
        "default": "./dist/error.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.js"
      },
      "require": {
        "types": "./dist/types.d.cts",
        "default": "./dist/types.cjs"
      }
    },
    "./auth": {
      "import": {
        "types": "./dist/auth.d.ts",
        "default": "./dist/auth.js"
      },
      "require": {
        "types": "./dist/auth.d.cts",
        "default": "./dist/auth.cjs"
      }
    },
    "./mock": {
      "import": {
        "types": "./dist/mock.d.ts",
        "default": "./dist/mock.js"
      },
      "require": {
        "types": "./dist/mock.d.cts",
        "default": "./dist/mock.cjs"
      }
    }
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "test:coverage": "vitest run --coverage",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "bench": "vitest bench",
    "typecheck": "tsc --noEmit",
    "version": "node scripts/sync-jsr-version.mjs && git add jsr.json",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "keywords": [
    "fetch",
    "http",
    "client",
    "valibot",
    "validation",
    "schema",
    "typescript",
    "type-safe",
    "api",
    "rest",
    "ai",
    "llm",
    "agent",
    "zod-alternative",
    "ky-alternative",
    "axios-alternative"
  ],
  "author": "haihv",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haihv/valifetch.git"
  },
  "bugs": {
    "url": "https://github.com/haihv/valifetch/issues"
  },
  "homepage": "https://github.com/haihv/valifetch#readme",
  "peerDependencies": {
    "valibot": ">=1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@codecov/rollup-plugin": "^2.0.1",
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@emnapi/wasi-threads": "^1.2.1",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "axios": "^1.16.0",
    "husky": "^9.1.7",
    "ky": "^2.0.2",
    "lint-staged": "^16.4.0",
    "ofetch": "^1.5.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "up-fetch": "^2.6.0",
    "valibot": "^1.3.1",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  }
}
