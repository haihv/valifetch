{
  "name": "valifetch",
  "version": "0.4.1",
  "description": "Type-safe HTTP client built on native fetch with valibot schema validation",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./error": {
      "import": {
        "types": "./dist/error.d.ts",
        "default": "./dist/error.js"
      },
      "require": {
        "types": "./dist/error.d.cts",
        "default": "./dist/error.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.js"
      },
      "require": {
        "types": "./dist/types.d.cts",
        "default": "./dist/types.cjs"
      }
    }
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "test:coverage": "vitest run --coverage",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "version": "node scripts/sync-jsr-version.mjs && git add jsr.json",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "keywords": [
    "fetch",
    "http",
    "client",
    "valibot",
    "validation",
    "schema",
    "typescript",
    "type-safe",
    "api",
    "rest"
  ],
  "author": "haihv",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haihv/valifetch.git"
  },
  "bugs": {
    "url": "https://github.com/haihv/valifetch/issues"
  },
  "homepage": "https://github.com/haihv/valifetch#readme",
  "peerDependencies": {
    "valibot": ">=1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "valibot": "^1.3.1",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  }
}
