{
  "name": "valifetch",
  "version": "0.2.0",
  "description": "Type-safe HTTP client built on native fetch with valibot schema validation",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./error": {
      "import": {
        "types": "./dist/error.d.ts",
        "default": "./dist/error.js"
      },
      "require": {
        "types": "./dist/error.d.cts",
        "default": "./dist/error.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.js"
      },
      "require": {
        "types": "./dist/types.d.cts",
        "default": "./dist/types.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --quiet",
    "format": "prettier --write . --log-level warn",
    "format:check": "prettier --check . --log-level warn",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "keywords": [
    "fetch",
    "http",
    "client",
    "valibot",
    "validation",
    "schema",
    "typescript",
    "type-safe",
    "api",
    "rest"
  ],
  "author": "haihv",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haihv/valifetch.git"
  },
  "bugs": {
    "url": "https://github.com/haihv/valifetch/issues"
  },
  "homepage": "https://github.com/haihv/valifetch#readme",
  "peerDependencies": {
    "valibot": ">=1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "valibot": "^1.3.1",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --quiet --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
